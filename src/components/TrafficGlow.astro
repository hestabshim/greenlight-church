---
/**
 * Projected traffic-light glow: three soft, translucent discs (red, yellow,
 * green) drifting slowly behind the page content, like light thrown onto a
 * wall, with the hard shadow of a hanging traffic-light head in it.
 *
 * In `astro dev` a tuning panel (TrafficGlowPanel.ts) is loaded on top; it is
 * not included in production builds. Toggle it with the backtick (`) key and
 * use "Copy" to get values to paste into DEFAULTS below.
 */
---

<traffic-glow></traffic-glow>

<style is:global>
    traffic-glow {
        display: contents;
    }

    /* Sits behind all page content: only the page background gets lit. */
    .traffic-glow__canvas {
        position: fixed;
        inset: 0;
        inline-size: 100vw;
        block-size: 100lvh;
        z-index: -1;
        pointer-events: none;
        opacity: 0;
        transition: opacity 1600ms ease;
    }
</style>

<script>
    // Production renders exactly these. Paste values from the dev panel's
    // "Copy" button here to change the defaults.
    const DEFAULTS = {
        opacity: 0.52,
        exposure: 1.79,
        saturation: 1.06,
        size: 0.29,
        softness: 0.36,
        bleed: 0.3,
        fringe: 0.035,
        aberration: 0.025,
        speed: 3.33,
        drift: 0.14,
        spread: 0.93,
        warp: 0.34,
        signal: 0.78,
        signalSize: 2.04,
        signalPosX: 0.71,
        signalPosY: 0.21,
        signalTilt: 0,
        lightDirection: 3.43,
        lightLength: 0.37,
        penumbra: 0.08,
        frame: 0,
        grain: 0.11,
        resolution: 0.8,
        red: 1.37,
        yellow: 0.34,
        green: 1.73,
        redColor: "#ff1a1a",
        yellowColor: "#eeff00",
        greenColor: "#00fa9a",
    };

    type Settings = typeof DEFAULTS;
    const VERT = `
        attribute vec2 aPos;
        void main() { gl_Position = vec4(aPos, 0.0, 1.0); }
    `;

    const FRAG = `
        precision highp float;
        uniform vec2 uRes;
        uniform float uTime;
        uniform float uSize;
        uniform float uSoft;
        uniform float uBleed;
        uniform float uSpread;
        uniform float uDrift;
        uniform float uWarp;
        uniform float uFringe;
        uniform float uAberration;
        uniform float uExposure;
        uniform float uSat;
        uniform float uFrame;
        uniform float uGrain;
        uniform float uSignal;
        uniform float uSignalSize;
        uniform vec2 uSignalPos;
        uniform float uSignalTilt;
        uniform float uLightDir;
        uniform float uLightLen;
        uniform float uPenumbra;
        uniform vec3 uRed;
        uniform vec3 uYellow;
        uniform vec3 uGreen;

        float gAspect;
        vec2 gRed;
        vec2 gYel;
        vec2 gGrn;
        vec2 gCast;

        float hash(vec2 p) {
            p = fract(p * vec2(123.34, 456.21));
            p += dot(p, p + 45.32);
            return fract(p.x * p.y);
        }

        float noise(vec2 p) {
            vec2 i = floor(p);
            vec2 f = fract(p);
            vec2 u = f * f * (3.0 - 2.0 * f);
            return mix(
                mix(hash(i), hash(i + vec2(1.0, 0.0)), u.x),
                mix(hash(i + vec2(0.0, 1.0)), hash(i + vec2(1.0, 1.0)), u.x),
                u.y
            );
        }

        float fbm(vec2 p) {
            float v = 0.0;
            float a = 0.5;
            for (int i = 0; i < 4; i++) {
                v += a * noise(p);
                p = p * 2.03 + 17.1;
                a *= 0.5;
            }
            return v;
        }

        vec2 rot(vec2 p, float a) {
            float s = sin(a);
            float c = cos(a);
            return vec2(c * p.x - s * p.y, s * p.x + c * p.y);
        }

        float band(float x, float a, float b, float blur) {
            return smoothstep(a - blur, a + blur, x) * (1.0 - smoothstep(b - blur, b + blur, x));
        }

        float sdRoundBox(vec2 p, vec2 b, float r) {
            vec2 q = abs(p) - b + r;
            return length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - r;
        }

        // Out-of-focus projected disc: flat core, soft rim, wide bleed.
        float disc(float d, float r) {
            float edge = max(r * uSoft, 0.001);
            float core = 1.0 - smoothstep(r - edge, r + edge, d);
            float spread = r * r * (1.5 + 3.0 * uBleed);
            float halo = exp(-(d * d) / spread);
            return core * 0.85 + halo * uBleed * 0.6;
        }

        // Dispersion: each channel lands at a slightly different radius,
        // which gives rainbow rims where lamps overlap.
        vec3 lamp(vec2 p, vec2 c, float r, vec3 col) {
            float d = length(p - c);
            return col * vec3(
                disc(d, r * (1.0 + uFringe)),
                disc(d, r),
                disc(d, r * (1.0 - uFringe))
            );
        }

        float sdSegment(vec2 p, vec2 a, vec2 b) {
            vec2 pa = p - a;
            vec2 ba = b - a;
            float h = clamp(dot(pa, ba) / dot(ba, ba), 0.0, 1.0);
            return length(pa - ba * h);
        }

        // Ring of radius r with a wedge of half-angle cut missing at the
        // bottom (the cut-away underside of a signal visor).
        float sdCutRing(vec2 d, float r, float th, float cut) {
            float a = atan(d.x, -d.y);
            if (abs(a) > cut) return abs(length(d) - r) - th;
            vec2 e = r * vec2(sin(cut), -cos(cut));
            return min(length(d - e), length(d - vec2(-e.x, e.y))) - th;
        }

        // ---- Signal head, modelled on a 12" three-section US signal ----
        // Local units: one section is 1 x 1. The shadow is a parallel
        // projection: every part is offset along gCast by its distance from
        // the wall, so depth turns into the swept shapes you see on a wall.

        const float HOUSING_DEPTH = 0.75;
        const float VISOR_LEN = 0.85;
        const float VISOR_R = 0.42;

        // Front/back face of the housing: three rounded sections with small
        // notches at the seams, plus wing-nut clamps on the hinge side.
        float sdFace(vec2 p) {
            float d = sdRoundBox(p - vec2(0.0, 1.0), vec2(0.5, 0.49), 0.1);
            d = min(d, sdRoundBox(p, vec2(0.5, 0.49), 0.1));
            d = min(d, sdRoundBox(p + vec2(0.0, 1.0), vec2(0.5, 0.49), 0.1));
            for (int i = 0; i < 4; i++) {
                float y = 1.3 - float(i) * 0.8667;
                d = min(d, sdRoundBox(p - vec2(0.54, y), vec2(0.06, 0.04), 0.015));
                d = min(d, sdRoundBox(p - vec2(0.6, y), vec2(0.022, 0.07), 0.012));
            }
            return d;
        }

        // Housing swept through its depth: Minkowski sum of the (convex)
        // outer box with the cast segment, found by ternary search.
        float sdHousing(vec2 p) {
            vec2 o = gCast * HOUSING_DEPTH;
            float lo = 0.0;
            float hi = 1.0;
            for (int i = 0; i < 10; i++) {
                float m1 = lo + (hi - lo) / 3.0;
                float m2 = hi - (hi - lo) / 3.0;
                float d1 = sdRoundBox(p - o * m1, vec2(0.5, 1.48), 0.1);
                float d2 = sdRoundBox(p - o * m2, vec2(0.5, 1.48), 0.1);
                if (d1 < d2) hi = m2; else lo = m1;
            }
            float sweep = sdRoundBox(p - o * 0.5 * (lo + hi), vec2(0.5, 1.48), 0.1);
            return min(sweep, min(sdFace(p), sdFace(p - o)));
        }

        // Tunnel visor: a tube sticking out of the front face whose
        // underside is cut away over the outer part of its length.
        float sdVisor(vec2 p, vec2 base) {
            vec2 v = gCast * VISOR_LEN;
            float t0 = 0.3;
            float d = sdSegment(p, base, base + v * t0) - VISOR_R;
            float stepLen = length(v) * (1.0 - t0) / 12.0;
            float th = 0.02 + stepLen * 0.6;
            for (int j = 0; j < 12; j++) {
                float t = t0 + (1.0 - t0) * (float(j) + 0.5) / 12.0;
                d = min(d, sdCutRing(p - base - v * t, VISOR_R, th, 1.05));
            }
            return d;
        }

        // Mounting bracket with three cut-outs, hook and chain to the ceiling.
        float sdHanger(vec2 p) {
            vec2 b = p - vec2(0.0, 1.66) - gCast * HOUSING_DEPTH * 0.5;
            float bracket = sdRoundBox(b, vec2(0.2, 0.17), 0.05);
            bracket = max(bracket, -(length(b - vec2(-0.1, 0.03)) - 0.045));
            bracket = max(bracket, -(length(b - vec2(0.0, 0.03)) - 0.045));
            bracket = max(bracket, -(length(b - vec2(0.1, 0.03)) - 0.045));
            float hook = abs(length(b - vec2(0.0, 0.27)) - 0.07) - 0.022;
            float chain = sdSegment(b, vec2(0.0, 0.34), vec2(0.0, 60.0)) - 0.022;
            return min(bracket, min(hook, chain));
        }

        // Hard shadow coverage (0..1) at screen point p.
        float signalShadow(vec2 p) {
            float unit = 0.1 * uSignalSize;
            vec2 lp = rot(p - vec2(uSignalPos.x * gAspect * 0.5, uSignalPos.y * 0.5), -uSignalTilt) / unit;
            vec2 front = gCast * HOUSING_DEPTH;
            float d = sdHousing(lp);
            d = min(d, sdVisor(lp, front + vec2(0.0, 1.0)));
            d = min(d, sdVisor(lp, front));
            d = min(d, sdVisor(lp, front + vec2(0.0, -1.0)));
            d = min(d, sdHanger(lp));
            // ~1px antialiasing, plus optional penumbra.
            float aa = (1.0 / uRes.y) / unit + uPenumbra * 0.25;
            return 1.0 - smoothstep(-aa, aa, d);
        }

        vec3 field(vec2 q, vec2 p) {
            float r = uSize;
            vec3 light = lamp(q, gRed, r * 1.15, uRed)
                + lamp(q, gYel, r * 0.9, uYellow)
                + lamp(q, gGrn, r, uGreen);

            // Soft window frame / moulding shadows.
            vec2 s = rot(q, -0.32);
            float occ = band(s.y, -0.16, -0.07, 0.04);
            occ = max(occ, band(s.y, -0.42, -0.36, 0.05));
            occ = max(occ, band(s.x, 0.18 * gAspect, 0.22 * gAspect, 0.05));
            light *= 1.0 - uFrame * occ;

            // Signal head: a hard shadow on the wall, so it uses the unwarped
            // position and stays put while the light moves through it.
            light *= 1.0 - uSignal * signalShadow(p);
            return light;
        }

        void main() {
            gAspect = uRes.x / uRes.y;
            vec2 p = (gl_FragCoord.xy - 0.5 * uRes) / uRes.y;
            float t = uTime;
            float sx = gAspect * 0.5;

            // Traffic light knocked sideways (red high, green low); each lamp
            // wanders on its own slow Lissajous path.
            gRed = vec2(-0.45 * sx, 0.22) * uSpread
                + uDrift * vec2(sin(t * 0.071 + 1.0) * sx * 0.6, sin(t * 0.053 + 0.4) * 0.35);
            gYel = vec2(0.05 * sx, -0.05) * uSpread
                + uDrift * vec2(sin(t * 0.047 + 2.7) * sx * 0.7, cos(t * 0.067 + 1.9) * 0.4);
            gGrn = vec2(0.5 * sx, -0.3) * uSpread
                + uDrift * vec2(cos(t * 0.059 + 4.1) * sx * 0.6, sin(t * 0.043 + 3.3) * 0.35);

            // Direction and length the signal's depth is thrown across the wall.
            gCast = vec2(cos(uLightDir), sin(uLightDir)) * uLightLen;

            // Organic wobble, like light passing through old glass.
            vec2 w = vec2(
                fbm(p * 1.3 + vec2(t * 0.04, -t * 0.03)),
                fbm(p * 1.3 + vec2(5.2 - t * 0.035, 1.3 + t * 0.045))
            ) - 0.5;
            vec2 q = p + w * uWarp * 0.6;

            // Lateral chromatic aberration: channels split radially, more
            // toward the edges of the screen.
            vec2 ca = p * uAberration;
            vec3 light = vec3(
                field(q + ca, p + ca).r,
                field(q, p).g,
                field(q - ca, p - ca).b
            );

            vec3 col = 1.0 - exp(-light * uExposure);
            float lum = dot(col, vec3(0.2126, 0.7152, 0.0722));
            col = clamp(mix(vec3(lum), col, uSat), 0.0, 1.0);

            col += (hash(gl_FragCoord.xy + fract(t * 7.0) * 113.0) - 0.5) * uGrain;
            gl_FragColor = vec4(col, 1.0);
        }
    `;

    const UNIFORMS = [
        "uRes", "uTime", "uSize", "uSoft", "uBleed", "uSpread", "uDrift", "uWarp",
        "uFringe", "uAberration", "uExposure", "uSat", "uFrame", "uGrain",
        "uSignal", "uSignalSize", "uSignalPos", "uSignalTilt", "uLightDir",
        "uLightLen", "uPenumbra", "uRed", "uYellow", "uGreen",
    ];

    function hexToRgb(hex: string): [number, number, number] {
        const n = Number.parseInt(hex.replace("#", ""), 16);
        return [((n >> 16) & 255) / 255, ((n >> 8) & 255) / 255, (n & 255) / 255];
    }

    class TrafficGlow extends HTMLElement {
        private canvas?: HTMLCanvasElement;
        private gl?: WebGLRenderingContext;
        private uniforms: Record<string, WebGLUniformLocation | null> = {};
        private settings: Settings = { ...DEFAULTS };
        private raf = 0;
        private time = 0;
        private last = 0;
        private paused = false;
        private dirty = true;
        private reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
        private cleanup: (() => void)[] = [];

        connectedCallback() {
            const canvas = document.createElement("canvas");
            canvas.className = "traffic-glow__canvas";
            canvas.setAttribute("aria-hidden", "true");
            this.append(canvas);
            this.canvas = canvas;

            const gl = canvas.getContext("webgl", {
                alpha: false,
                antialias: false,
                powerPreference: "low-power",
            });
            if (!gl || !this.initGl(gl)) {
                canvas.remove();
                return;
            }
            this.gl = gl;

            // Start somewhere mid-drift so the first frame isn't the base layout.
            this.time = 40 + Math.random() * 200;
            this.resize();

            const onResize = () => {
                this.resize();
                this.dirty = true;
            };
            window.addEventListener("resize", onResize);
            this.cleanup.push(() => window.removeEventListener("resize", onResize));

            // Dev-only tuning panel. The DEV check is a build-time constant,
            // so production bundles drop this import entirely.
            if (import.meta.env.DEV) {
                import("./TrafficGlowPanel").then(({ attachTuningPanel }) => {
                    if (!this.isConnected) return;
                    this.cleanup.push(
                        attachTuningPanel({
                            mount: this,
                            defaults: DEFAULTS,
                            getSettings: () => this.settings,
                            apply: (next) => this.apply(next as Settings),
                            togglePause: () => (this.paused = !this.paused),
                        }),
                    );
                });
            }

            // Fade in once, then drop the transition so the opacity slider is instant.
            requestAnimationFrame(() => {
                canvas.style.opacity = String(this.settings.opacity);
                canvas.addEventListener(
                    "transitionend",
                    () => (canvas.style.transition = "none"),
                    { once: true },
                );
            });
            this.last = performance.now();
            this.raf = requestAnimationFrame(this.frame);
        }

        disconnectedCallback() {
            cancelAnimationFrame(this.raf);
            for (const fn of this.cleanup) fn();
            this.cleanup = [];
            this.gl?.getExtension("WEBGL_lose_context")?.loseContext();
            this.gl = undefined;
            this.replaceChildren();
        }

        private initGl(gl: WebGLRenderingContext) {
            const compile = (type: number, src: string) => {
                const shader = gl.createShader(type)!;
                gl.shaderSource(shader, src);
                gl.compileShader(shader);
                if (!gl.getShaderParameter(shader, gl.COMPILE_STATUS)) {
                    console.error(gl.getShaderInfoLog(shader));
                    return null;
                }
                return shader;
            };
            const vs = compile(gl.VERTEX_SHADER, VERT);
            const fs = compile(gl.FRAGMENT_SHADER, FRAG);
            if (!vs || !fs) return false;

            const program = gl.createProgram()!;
            gl.attachShader(program, vs);
            gl.attachShader(program, fs);
            gl.linkProgram(program);
            if (!gl.getProgramParameter(program, gl.LINK_STATUS)) {
                console.error(gl.getProgramInfoLog(program));
                return false;
            }
            gl.useProgram(program);

            gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer());
            gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
            const loc = gl.getAttribLocation(program, "aPos");
            gl.enableVertexAttribArray(loc);
            gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);

            for (const name of UNIFORMS) {
                this.uniforms[name] = gl.getUniformLocation(program, name);
            }
            return true;
        }

        private resize() {
            if (!this.canvas) return;
            const scale = this.settings.resolution;
            this.canvas.width = Math.max(1, Math.round(window.innerWidth * scale));
            this.canvas.height = Math.max(1, Math.round(window.innerHeight * scale));
        }

        private frame = (now: number) => {
            this.raf = requestAnimationFrame(this.frame);
            const dt = Math.min((now - this.last) / 1000, 0.1);
            this.last = now;

            const animating =
                !this.paused && !this.reducedMotion.matches && this.settings.speed > 0;
            if (animating) this.time += dt * this.settings.speed;
            if (!animating && !this.dirty) return;
            this.dirty = false;
            this.render();
        };

        private render() {
            const gl = this.gl;
            const canvas = this.canvas;
            if (!gl || !canvas) return;
            const s = this.settings;
            const u = this.uniforms;
            const lamp = (hex: string, level: number) => hexToRgb(hex).map((c) => c * level);

            gl.viewport(0, 0, canvas.width, canvas.height);
            gl.uniform2f(u.uRes, canvas.width, canvas.height);
            gl.uniform1f(u.uTime, this.time);
            gl.uniform1f(u.uSize, s.size);
            gl.uniform1f(u.uSoft, s.softness);
            gl.uniform1f(u.uBleed, s.bleed);
            gl.uniform1f(u.uSpread, s.spread);
            gl.uniform1f(u.uDrift, s.drift);
            gl.uniform1f(u.uWarp, s.warp);
            gl.uniform1f(u.uFringe, s.fringe);
            gl.uniform1f(u.uAberration, s.aberration);
            gl.uniform1f(u.uExposure, s.exposure);
            gl.uniform1f(u.uSat, s.saturation);
            gl.uniform1f(u.uFrame, s.frame);
            gl.uniform1f(u.uGrain, s.grain);
            gl.uniform1f(u.uSignal, s.signal);
            gl.uniform1f(u.uSignalSize, s.signalSize);
            gl.uniform2f(u.uSignalPos, s.signalPosX, s.signalPosY);
            gl.uniform1f(u.uSignalTilt, s.signalTilt);
            gl.uniform1f(u.uLightDir, s.lightDirection);
            gl.uniform1f(u.uLightLen, s.lightLength);
            gl.uniform1f(u.uPenumbra, s.penumbra);
            gl.uniform3fv(u.uRed, lamp(s.redColor, s.red));
            gl.uniform3fv(u.uYellow, lamp(s.yellowColor, s.yellow));
            gl.uniform3fv(u.uGreen, lamp(s.greenColor, s.green));
            gl.drawArrays(gl.TRIANGLES, 0, 3);
        }

        private apply(next: Settings) {
            const resized = next.resolution !== this.settings.resolution;
            this.settings = next;
            if (resized) this.resize();
            if (this.canvas) this.canvas.style.opacity = String(next.opacity);
            this.dirty = true;
        }
    }

    if (!customElements.get("traffic-glow")) {
        customElements.define("traffic-glow", TrafficGlow);
    }

    // A custom element can't be redefined, so hot updates would keep running
    // the old class. Force a full reload in dev instead.
    import.meta.hot?.decline();
</script>
